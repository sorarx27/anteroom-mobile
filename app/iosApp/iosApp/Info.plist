<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The app uses only HTTPS and the platform's own TLS, which is exempt
	     under the US export regulations. Declaring it here stops App Store
	     Connect asking the export-compliance question on every single upload,
	     which is otherwise a manual gate between an archive and TestFlight. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required. Presenting UIImagePickerController with the camera source
	     without this key terminates the app with SIGABRT before anything is
	     drawn. The gallery path uses PHPickerViewController, which runs out of
	     process and needs no library permission, but the description is kept
	     for the UIImagePickerController fallback. -->
	<key>NSCameraUsageDescription</key>
	<string>Anteroom uses the camera to photograph your medical paperwork so it can be turned into a brief. Photos stay in your account.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Anteroom needs access to your photos so you can add existing pictures of referrals, medication lists, and lab results to a brief.</string>
</dict>
</plist>